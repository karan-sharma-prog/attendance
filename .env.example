# ==============================================================================
# SMARTPRESENCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with your real values.
# NEVER commit your actual .env file with secrets into version control.

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=SmartPresence
API_V1_STR=/api/v1
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Host, Port & Base URL used inside generated Dynamic QR verification links
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://your-smartpresence-domain.com
APP_BASE_URL=https://your-smartpresence-domain.com
DEFAULT_GEOFENCE_RADIUS_METERS=150.0

# Allowed CORS Origins (JSON array or comma-separated)
CORS_ORIGINS=["https://your-smartpresence-domain.com","https://localhost:5173"]

# Database (Neon PostgreSQL with SSL)
# Format: postgresql+asyncpg://<username>:<password>@<ep-pool-host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=
DATABASE_URL_SYNC=

# Redis Cache & WebSockets Session Broker
# For Upstash or cloud Redis: rediss://default:<password>@<host>:<port>
# For local Redis / fallback: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Biometric & Cryptographic Security
BIOMETRIC_ENCRYPTION_KEY_HEX=generate_32_byte_hex_key_for_aes_256_gcm
QR_HMAC_SECRET=generate_strong_hmac_secret_key

# Face Verification Thresholds (ArcFace ResNet-100 Cosine Similarity)
ARCFACE_SIMILARITY_THRESHOLD=0.68
MINIFASNET_LIVENESS_THRESHOLD=0.85
BLINK_EAR_THRESHOLD=0.22
MOUTH_MAR_THRESHOLD=0.55

# Email & SMTP Alert Configuration (Low-Attendance Warning System)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=smartpresence-alerts@institution.edu
SMTP_TLS=True
ATTENDANCE_WARNING_THRESHOLD_PERCENT=75.0
